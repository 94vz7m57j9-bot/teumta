{
  "name": "teumta",
  "main": "src/worker.py",
  "compatibility_date": "2025-11-02",
  "compatibility_flags": ["python_workers", "python_dedicated_snapshot"],
  "assets": { "directory": "./static", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "local", "database_id": "local" }]
}
